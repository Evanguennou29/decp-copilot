# Copy to .env and fill in as needed — the app works fully without any of
# these (see README, "runs without an API key").

# Optional: enables LLM-drafted answers with citations (OpenAI-compatible).
# OPENAI_API_KEY=

# Optional: local fallback used when no OPENAI_API_KEY is set.
# OLLAMA_BASE_URL=http://localhost:11434

# Optional: where downloaded/normalized data is stored.
# DECP_DATA_DIR=data
